{
  "manifest_version": 3,
  "name": "Pentest Identity Bypass",
  "version": "1.0",
  "description": "Removes identity verification popups and restores page scrolling.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}